<?xml version="1.0" encoding="utf-8"?>
<!--
    Veri çıkarma kuralları (API 31+ / dataExtractionRules).

    İndirilen videolar (external domain) bulut yedeklemesine ve cihazlar arası
    aktarıma dahil EDİLMEZ: yedek kotasını doldurur ve indirmeler cihazlar
    arasında kopuk/bozuk kalmalıdır.

    Veritabanı (watchlist, favoriler, izleme geçmişi) ve tercihler yedeklenir.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
