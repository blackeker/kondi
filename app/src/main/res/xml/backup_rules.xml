<?xml version="1.0" encoding="utf-8"?>
<!--
    Yedekleme kuralları (API 23-30 / fullBackupContent).

    Uygulama indirilen videoları getExternalFilesDir() içinde tutuyor. Bu klasör
    "external" domainine aittir ve GB'larca yer kaplayabilir. Yedekleme
    kotasını doldurup kullanıcının verilerini yedekleyememesine yol açmaması
    için video klasörleri yedekleme dışı bırakılmıştır.

    Watchlist / favoriler / izleme geçmişi / ayarlar (database, sharedpref, file)
    yedeklenmeye devam eder.
-->
<full-backup-content>
    <exclude domain="external" path="." />
</full-backup-content>
